{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": ["index.md", "toc.yml", "guia/**/*.md"],
    "resource": [
      "guia/imagenes/**/*.png",
      "guia/imagenes/**/*.jpg",
      "guia/imagenes/**/*.jpeg",
      "guia/imagenes/**/*.svg",
      "guia/imagenes/**/*.gif",
      "guia/imagenes/**/*.webp"
    ],
    "dest": "_site",
    "template": ["default", "modern", "custom-template"],
    "globalMetadata": {
      "_appName": "SAVCNG",
      "_appTitle": "Guía de uso",
      "_appLogoPath": "guia/imagenes/logos/SAVCNG_Logo.png",
      "_lang": "es-MX",
      "_enableSearch": true
    }
  }
}
